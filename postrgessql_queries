UPDATE attendance_records
SET
    classes_held = CASE subject_code
        WHEN 'HU1011-1' THEN 35
        WHEN 'IS1604-1' THEN 40
        WHEN 'IS2002-1' THEN 38
        WHEN 'IS3001-1' THEN 42
        WHEN 'IS3101-1' THEN 36
    END,

    classes_attended = CASE subject_code
        WHEN 'HU1011-1' THEN 28
        WHEN 'IS1604-1' THEN 33
        WHEN 'IS2002-1' THEN 29
        WHEN 'IS3001-1' THEN 36
        WHEN 'IS3101-1' THEN 25
    END,

    attendance_percentage = CASE subject_code
        WHEN 'HU1011-1' THEN ROUND((28.0 / 35) * 100, 2)
        WHEN 'IS1604-1' THEN ROUND((33.0 / 40) * 100, 2)
        WHEN 'IS2002-1' THEN ROUND((29.0 / 38) * 100, 2)
        WHEN 'IS3001-1' THEN ROUND((36.0 / 42) * 100, 2)
        WHEN 'IS3101-1' THEN ROUND((25.0 / 36) * 100, 2)
    END
WHERE subject_code IN (
    'HU1011-1',
    'IS1604-1',
    'IS2002-1',
    'IS3001-1',
    'IS3101-1'
);
