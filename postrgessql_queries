INSERT INTO attendance_records (
    student_id,
    subject_code,
    subject_name,
    classes_held,
    classes_attended,
    attendance_percentage,
    source
)
SELECT
    s.id AS student_id,

    sub.subject_code,

    sub.subject_name,

    h.classes_held AS NCC,

    a.classes_attended AS NAC,

    ROUND(
        (a.classes_attended::numeric / h.classes_held::numeric) * 100,
        2
    ) AS attendance_percentage,

    'fake_data' AS source

FROM students s

CROSS JOIN (
    VALUES
        ('IS3001-1', 'DCN: Data Communication and Networking'),
        ('IS2002-1', 'ML: Machine Learning Foundations'),
        ('IS3101-1', 'OS: Operating Systems Fundamentals'),
        ('HU1011-1', 'UHV: Universal Human Values'),
        ('IS1604-1', 'MD: MERNSTACK Development')
) AS sub(subject_code, subject_name)

CROSS JOIN LATERAL (
    SELECT
        (25 + floor(random() * 16))::int AS classes_held
) h

CROSS JOIN LATERAL (
    SELECT
        GREATEST(
            0,
            LEAST(
                h.classes_held,
                floor(
                    h.classes_held *
                    (0.65 + random() * 0.31)
                )
            )
        )::int AS classes_attended
) a

WHERE s.semester = 5;



