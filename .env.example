# ============================================================
# EduGuardian AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to git.
# ============================================================

# ── PostgreSQL Database ──────────────────────────────────────
# Full async connection string for PostgreSQL.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# In Docker: use the service name "db" as the host.
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@localhost:5432/eduguardian_chatbot

# Optional pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── LLM Provider Configuration ──────────────────────────────
# Controls which LLM backend is used.
#   auto       — Prefers direct Groq if GROQ_API_KEY is set, else OmniRoute
#   groq       — Forces direct Groq API (requires GROQ_API_KEY)
#   omniroute  — Forces OmniRoute gateway (requires OMNIROUTE_API_KEY)
LLM_PROVIDER=auto

# OmniRoute LLM Gateway (local or hosted proxy)
# Leave blank if you do not use OmniRoute.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key-here
OMNIROUTE_MODEL=groq/llama-3.3-70b-versatile
OMNIROUTE_TIMEOUT_SECONDS=4.0

# Direct Groq API (official endpoint — fallback when OmniRoute is unavailable)
# Get your key at https://console.groq.com/keys
# Leave blank to disable direct Groq and use OmniRoute only.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=10.0

# ── JWT Authentication ───────────────────────────────────────
# Secret key used to verify JWT tokens. Generate a strong random string.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret-key
JWT_ALGORITHM=HS256

# ── FastAPI Application ─────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Student Context Caching ──────────────────────────────────
# Server-side cache TTL for student academic records (in seconds)
STUDENT_CONTEXT_CACHE_TTL_SECONDS=3600

# ── A2A Agent Microservices ──────────────────────────────────
# URLs of the independent A2A agent services.
# In Docker Compose these use service names; locally they use localhost.
A2A_USE_REMOTE_SERVICES=true
STUDENT_INSIGHT_AGENT_URL=http://localhost:8001
STUDY_PLANNER_AGENT_URL=http://localhost:8002
RECOVERY_COACH_AGENT_URL=http://localhost:8003
A2A_TIMEOUT_SECONDS=45.0
