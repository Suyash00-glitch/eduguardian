# ============================================================
# EduGuardian AI - Environment Variables Template
# ============================================================
# Copy this file to .env and customize if needed.
# ============================================================

# ── PostgreSQL Database ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Chatbot Async SQLAlchemy Connection URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eduguardian_chatbot

# edu-backend Sync Connection URL
database_url=postgresql://postgres:postgres@localhost:5432/eduguardian

# Database Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Secret Keys & Security ────────────────────────────────────
SECRET_KEY=eduguardian-dev-secret-key-2026
JWT_SECRET_KEY=eduguardian-super-secret-key-2024
JWT_ALGORITHM=HS256

# ── LLM Provider Configuration ────────────────────────────────
# auto | groq | omniroute
LLM_PROVIDER=auto

# OmniRoute LLM Gateway
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=not-configured
OMNIROUTE_MODEL=openai/gpt-oss-120b
OMNIROUTE_TIMEOUT_SECONDS=15.0

# Direct Groq API (Fallback / Alternative)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=10.0

# ── Application & CORS ────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost,http://localhost:80

# ── Student Context Caching ───────────────────────────────────
STUDENT_CONTEXT_CACHE_TTL_SECONDS=3600

# ── A2A Agent Microservices ───────────────────────────────────
A2A_USE_REMOTE_SERVICES=true
STUDENT_INSIGHT_AGENT_URL=http://localhost:8001
STUDY_PLANNER_AGENT_URL=http://localhost:8002
RECOVERY_COACH_AGENT_URL=http://localhost:8003
A2A_TIMEOUT_SECONDS=45.0

# ── Frontend API URLs ─────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=/api
