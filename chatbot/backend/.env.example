# ============================================================
# EduGuardian AI 2.0 — Chatbot Backend Environment Variables
# Copy this file to .env and configure your values.
# NEVER commit real .env files with secrets to git.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── PostgreSQL Database ──────────────────────────────────────
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# Docker Compose: use service name "db" as host, e.g. @db:5432
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@localhost:5432/eduguardian_chatbot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── LLM Provider Configuration ───────────────────────────────
# auto       — Prefers direct Groq if GROQ_API_KEY is set, else OmniRoute
# groq       — Forces direct Groq API
# omniroute  — Forces OmniRoute gateway
LLM_PROVIDER=auto

# OmniRoute LLM Gateway (local or hosted)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key-here
OMNIROUTE_MODEL=groq/llama-3.3-70b-versatile
OMNIROUTE_TIMEOUT_SECONDS=4.0

# Direct Groq API — fallback when OmniRoute is unavailable
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=10.0

# ── Student Context Caching ──────────────────────────────────
# Server-side cache TTL for student academic records (in seconds)
STUDENT_CONTEXT_CACHE_TTL_SECONDS=3600

# ── A2A Agent Microservices ──────────────────────────────────
# Set to "false" to use in-process agents (no separate microservices needed)
A2A_USE_REMOTE_SERVICES=true
STUDENT_INSIGHT_AGENT_URL=http://localhost:8001
STUDY_PLANNER_AGENT_URL=http://localhost:8002
RECOVERY_COACH_AGENT_URL=http://localhost:8003
A2A_TIMEOUT_SECONDS=45.0

# ── JWT Verification ─────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret-key
JWT_ALGORITHM=HS256
